{
  "mcpServers": {
    "gcp-calculator": {
      "command": "__HOME__/.local/bin/gcp-calculator-mcp",
      "args": [
        "server"
      ]
    },
    "puppeteer": {
      "command": "npx",
      "args": [
        "-y",
        "@modelcontextprotocol/server-puppeteer"
      ]
    },
    "google-workspace": {
      "command": "uvx",
      "args": [
        "google-workspace-mcp"
      ]
    },
    "google-cloud": {
      "command": "uvx",
      "args": [
        "google-cloud-mcp"
      ]
    },
    "kicad": {
      "command": "uvx",
      "args": [
        "kicad-mcp"
      ]
    },
    "github": {
      "command": "npx",
      "args": [
        "-y",
        "@modelcontextprotocol/server-github"
      ]
    },
    "gitlab": {
      "command": "npx",
      "args": [
        "-y",
        "@modelcontextprotocol/server-gitlab"
      ]
    },
    "memory": {
      "command": "npx",
      "args": [
        "-y",
        "@modelcontextprotocol/server-memory"
      ]
    },
    "figma": {
      "command": "uvx",
      "args": [
        "figma-developer-mcp"
      ]
    },
    "duckduckgo": {
      "command": "uvx",
      "args": [
        "duckduckgo-mcp-server"
      ]
    },
    "gmail": {
      "command": "npx",
      "args": [
        "-y",
        "@gongrzhe/server-gmail-autoauth-mcp"
      ]
    }
  }
}
