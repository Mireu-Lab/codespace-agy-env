{
  "mcpServers": {
    "gcp-calculator": {
      "command": "__HOME__/.local/bin/gcp-calculator-mcp",
      "args": [
        "server"
      ]
    },
    "puppeteer": {
      "command": "npx",
      "args": [
        "-y",
        "@modelcontextprotocol/server-puppeteer"
      ]
    },
    "google-workspace": {
      "command": "uvx",
      "args": [
        "--from",
        "google-workspace-mcp",
        "google-workspace-worker"
      ],
      "env": {
        "GOOGLE_WORKSPACE_CLIENT_ID": "",
        "GOOGLE_WORKSPACE_CLIENT_SECRET": "",
        "GOOGLE_WORKSPACE_REFRESH_TOKEN": "",
        "GOOGLE_WORKSPACE_ENABLED_CAPABILITIES": "[\"drive\", \"docs\", \"gmail\", \"calendar\", \"sheets\"]"
      }
    },
    "memory": {
      "command": "npx",
      "args": [
        "-y",
        "@modelcontextprotocol/server-memory"
      ]
    },
    "figma": {
      "command": "uvx",
      "args": [
        "figma-developer-mcp"
      ]
    },
    "duckduckgo": {
      "command": "uvx",
      "args": [
        "duckduckgo-mcp-server"
      ]
    },
    "gmail": {
      "command": "npx",
      "args": [
        "-y",
        "@gongrzhe/server-gmail-autoauth-mcp"
      ]
    }
  }
}
