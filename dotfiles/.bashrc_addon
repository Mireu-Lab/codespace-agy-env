# ==============================================================================
# Limmireu AGY & Development Environment Configuration for Codespaces
# ==============================================================================

# 1. Environment & PATH
export PATH="$HOME/.local/bin:$HOME/go/bin:/usr/local/go/bin:$PATH"
export GOPATH="$HOME/go"

# 2. Aliases for Productivity & Limmireu Standards
alias agy="$HOME/.local/bin/agy"
alias ll="ls -alF --color=auto"
alias gs="git status -sb"
alias gl="git log --oneline --graph --decorate -n 15"
alias gco="git checkout"
alias gcb="git checkout -b"

# 3. Brain Directory Cleanup at Session End (Optional Utility)
alias agy-clean="$HOME/.local/bin/clean_brain_archive.sh"
alias agy-pricing-update="$HOME/.local/bin/update_gcp_pricing.sh"

# 4. GitFlow & Limmireu Defaults
export GIT_DISCOVERY_ACROSS_FILESYSTEM=1
